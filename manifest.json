{
  "manifest_version": 3,
  "name": "Nike SNKRS Bot SG",
  "version": "4.43",
  "description": "Auto-selects size and submits SNKRS raffle entries on nike.com/sg. Multi-account dashboard launches each Chrome profile for the same drop.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "nativeMessaging",
    "cookies",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "license.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SNKRS Bot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nike.com/sg/launch/*",
        "https://nike.com/sg/launch/*",
        "https://www.nike.com/sg/member/*",
        "https://nike.com/sg/member/*"
      ],
      "js": [
        "bootstrap-content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nike.com/sg/launch/*",
        "https://nike.com/sg/launch/*"
      ],
      "js": [
        "snkrs-content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gs.nike.com/*"
      ],
      "js": [
        "gs-bootstrap-content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gs.nike.com/*"
      ],
      "js": [
        "checkout-core.js",
        "gs-content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gs-payments.nike.com/*"
      ],
      "js": [
        "gs-payments-content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.nike.com/*orders*",
        "https://nike.com/*orders*"
      ],
      "js": [
        "orders-fetch-interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nike.com/*orders*",
        "https://nike.com/*orders*"
      ],
      "js": [
        "orders-content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
